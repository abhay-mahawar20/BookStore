<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f7f7f5">
    <title>Home | Book World</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; color: #26332a; background: #f7f7f5; font-family: Arial, Helvetica, sans-serif; }
        .home-shell { width: min(1120px, calc(100% - 32px)); margin: 34px auto 64px; }
        .welcome {
            display: grid;
            grid-template-columns: minmax(0, 1.25fr) minmax(240px, .75fr);
            align-items: center;
            gap: 32px;
            min-height: 360px;
            overflow: hidden;
            padding: clamp(28px, 6vw, 64px);
            border-radius: 14px;
            color: #f8f8f4;
            background: #314c37;
        }
        .welcome-label { margin: 0 0 14px; color: #d4dfd1; font-size: .78rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
        .welcome h1 { max-width: 570px; margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.5rem, 6vw, 4.25rem); font-weight: 500; line-height: 1.05; }
        .welcome-copy { max-width: 520px; margin: 18px 0 0; color: #e2e9df; font-size: 1.02rem; line-height: 1.7; }
        .welcome-actions { display: flex; flex-wrap: wrap; gap: 11px; margin-top: 26px; }
        .home-button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 17px; border: 1px solid #fff; border-radius: 7px; color: #314c37; background: #fff; font-weight: 700; text-decoration: none; transition: transform .18s ease, background .18s ease; }
        .home-button:hover { transform: translateY(-2px); background: #edf2eb; }
        .home-button.secondary { color: #fff; background: transparent; }
        .home-button.secondary:hover { background: rgb(255 255 255 / 12%); }
        .book-art { position: relative; display: flex; align-items: center; justify-content: center; min-height: 245px; }
        .book-art::before { position: absolute; width: 230px; height: 230px; border: 1px solid rgb(255 255 255 / 16%); border-radius: 50%; content: ""; }
        .book { position: relative; width: 112px; height: 170px; border: 1px solid rgb(255 255 255 / 28%); border-radius: 4px 9px 9px 4px; box-shadow: 5px 8px 18px rgb(0 0 0 / 18%); }
        .book::before { position: absolute; top: 0; bottom: 0; left: 10px; width: 1px; background: rgb(255 255 255 / 25%); content: ""; }
        .book::after { position: absolute; right: 13px; bottom: 26px; left: 22px; height: 2px; background: rgb(255 255 255 / 55%); box-shadow: 0 7px 0 rgb(255 255 255 / 36%); content: ""; }
        .book-one { z-index: 1; margin-right: -12px; background: #b66b4e; transform: rotate(-12deg) translateY(8px); }
        .book-two { z-index: 2; background: #d1ae69; transform: rotate(2deg) translateY(-8px); }
        .book-three { z-index: 1; margin-left: -12px; background: #758d76; transform: rotate(12deg) translateY(8px); }
        .browse-section { padding-top: 42px; }
        .section-heading { margin-bottom: 18px; }
        .section-heading h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.85rem; font-weight: 500; }
        .section-heading p { margin: 7px 0 0; color: #69716b; }
        .browse-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
        .browse-card { display: block; padding: 22px; border: 1px solid #e1e5de; border-radius: 9px; color: inherit; background: #fff; text-decoration: none; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
        .browse-card:hover { transform: translateY(-3px); border-color: #bfcbbf; box-shadow: 0 9px 20px rgb(34 47 37 / 7%); }
        .browse-card span { display: inline-block; margin-bottom: 13px; color: #59725e; font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
        .browse-card h3 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.3rem; font-weight: 600; }
        .browse-card p { margin: 8px 0 0; color: #69716b; font-size: .92rem; line-height: 1.55; }

        @media (max-width: 700px) {
            .home-shell { margin-top: 20px; }
            .welcome { grid-template-columns: 1fr; gap: 8px; }
            .book-art { min-height: 190px; }
            .browse-grid { grid-template-columns: 1fr; gap: 11px; }
            .browse-card { padding: 18px; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
        }
    </style>
</head>
<body>
    <%- include('includes/nav.ejs') %>
    <main class="home-shell">
        <section class="welcome" aria-labelledby="welcome-title">
            <div>
                <p class="welcome-label">Welcome to Book World</p>
                <h1 id="welcome-title">A little time. A good book.</h1>
                <p class="welcome-copy">Discover a collection of stories and ideas, find a new favorite, and make room for your next great read.</p>
                <div class="welcome-actions">
                    <a class="home-button" href="/books">Browse books</a>
                    <a class="home-button secondary" href="/category">Explore categories</a>
                </div>
            </div>
            <div class="book-art" aria-hidden="true">
                <span class="book book-one"></span>
                <span class="book book-two"></span>
                <span class="book book-three"></span>
            </div>
        </section>

        <section class="browse-section" aria-labelledby="browse-title">
            <div class="section-heading">
                <h2 id="browse-title">Where would you like to start?</h2>
                <p>Choose a simple way to explore the shelves.</p>
            </div>
            <div class="browse-grid">
                <a class="browse-card" href="/books">
                    <span>Every shelf</span>
                    <h3>Browse all books</h3>
                    <p>See the full collection and explore all available titles.</p>
                </a>
                <a class="browse-card" href="/category">
                    <span>By interest</span>
                    <h3>Explore categories</h3>
                    <p>Find books grouped by the subjects and stories they explore.</p>
                </a>
                <a class="browse-card" href="/about">
                    <span>Our bookstore</span>
                    <h3>About Book World</h3>
                    <p>Learn a little more about Book World and what you can find here.</p>
                </a>
            </div>
        </section>
    </main>
    <%- include('includes/footer.ejs') %>
</body>
</html>
