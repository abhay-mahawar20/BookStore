<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit | Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <%- include('includes/nav.ejs') %>
        <form action="/books/edit/<%= book._id %>" method="POST" enctype="multipart/form-data">

        <label>Title:</label>
        <input type="text" name="title" value="<%= book.title %>" required>
        <br><br>

        <label>Author:</label>
        <input type="text" name="author" value="<%= book.author %>" required>
        <br><br>

        <label>Price:</label>
        <input type="number" name="price" value="<%= book.price %>" required>
        <br><br>

        <label>Category:</label>
        <input type="text" name="category" value="<%= book.category %>" required>
        <br><br>

        <label>Current Image:</label>
        <br>

        <img src="<%= book.img %>" width="150">
        <br><br>

        <label>New Image:</label>
        <input type="file" name="img">
        <br><br>

        <button type="submit">Update Book</button>
</form>
    <%-include('includes/footer.ejs')  %>
</body>
</html>